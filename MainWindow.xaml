<Window x:Class="LocalFileTools.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LocalFileTools" Width="1180" Height="660" MinWidth="850" MinHeight="520" Background="{StaticResource BackgroundBrush}" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
        <Image Source="Assets/LocalFileTools-logo.png" Width="56" Height="56" Margin="0,0,12,0"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="LocalFileTools" FontSize="28" FontWeight="SemiBold"/>
          <TextBlock Text="Private file tools that run on your computer" Foreground="#627085" Margin="0,4,0,0"/>
        </StackPanel>
      </StackPanel>
      <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="AddFiles_Click" Content="Add files"/>
      <Button DockPanel.Dock="Right" HorizontalAlignment="Right" Click="Clear_Click" Content="Clear"/>
    </DockPanel>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="18">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock Text="Selected files" FontSize="18" FontWeight="SemiBold"/>
            <TextBlock x:Name="SelectionSummary" Text="Drop files here or select files" Foreground="#627085" Margin="0,5,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="Drag files to change their order." Foreground="#627085" FontSize="11" Margin="0,7,0,0"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0"><Button Click="Remove_Click" Content="Remove selected"/></StackPanel>
          <Grid>
            <ListBox x:Name="FileList" BorderThickness="0" Background="Transparent" AllowDrop="True" PreviewMouseLeftButtonDown="FileList_MouseDown" PreviewMouseMove="FileList_MouseMove" DragOver="FileList_DragOver" DragLeave="FileList_DragLeave" Drop="FileList_Drop" PreviewKeyDown="FileList_KeyDown">
              <ListBox.ItemTemplate>
                <DataTemplate><Grid Margin="0,5,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⋮⋮" Foreground="#627085" FontSize="15" VerticalAlignment="Center" ToolTip="Drag to reorder"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="Medium"/><TextBlock Text="{Binding Format}" Foreground="#627085" FontSize="11"/></StackPanel></Grid></DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <Canvas IsHitTestVisible="False"><Border x:Name="FileDropLine" Background="#2766CF" Height="3" Visibility="Collapsed"/></Canvas>
          </Grid>
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="24">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <TextBlock x:Name="PanelTitle" Text="What would you like to do?" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock x:Name="PanelSubtitle" Text="Choose files to see relevant actions." Foreground="#627085" Margin="0,6,0,18" TextWrapping="Wrap"/>
            <StackPanel x:Name="ToolSearchPanel" Margin="0,0,0,12"><TextBox x:Name="ToolSearchBox" Padding="10" MinHeight="36" TextChanged="ToolSearchBox_TextChanged" ToolTip="Search available tools"/><TextBlock Text="Search available tools" Foreground="#627085" FontSize="11" Margin="0,3,0,0"/></StackPanel>
            <StackPanel x:Name="ActionPanel"/>
            <StackPanel x:Name="OptionsPanel" Visibility="Collapsed">
              <StackPanel x:Name="PagePlanPanel" Visibility="Collapsed">
                <TextBlock Text="Arrange pages" FontWeight="SemiBold" FontSize="16" Margin="0,6,0,4"/>
                <TextBlock x:Name="PagePlanHint" Foreground="#627085" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <Grid Height="260"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="200"/></Grid.ColumnDefinitions>
                  <Grid Grid.Column="0">
                    <ListBox x:Name="PageList" SelectionChanged="PageList_SelectionChanged" AllowDrop="True" PreviewMouseLeftButtonDown="PageList_MouseDown" PreviewMouseMove="PageList_MouseMove" DragOver="PageList_DragOver" DragLeave="PageList_DragLeave" Drop="PageList_Drop" PreviewKeyDown="PageList_KeyDown">
                      <ListBox.ItemTemplate><DataTemplate><Border Padding="7" Margin="2" CornerRadius="6" BorderThickness="1" Background="#F3F6FB" BorderBrush="#DCE4EF" ToolTip="Drag this page to choose its position"><DockPanel><TextBlock DockPanel.Dock="Left" Text="⋮⋮" Foreground="#627085" Margin="0,0,9,0"/><TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/></DockPanel></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Canvas IsHitTestVisible="False"><Border x:Name="PageDropLine" Background="#2766CF" Height="4" Visibility="Collapsed"/></Canvas>
                  </Grid>
                  <Border Grid.Column="2" Background="#F0F3F9" CornerRadius="8" Padding="6"><Image x:Name="PagePreview" Stretch="Uniform"/></Border>
                </Grid>
                <WrapPanel Margin="0,8,0,0"><Button Click="RotateLeft_Click" Content="Rotate left"/><Button Click="RotateRight_Click" Content="Rotate right"/><Button Click="RemovePage_Click" Content="Remove page"/></WrapPanel>
              </StackPanel>
              <TextBlock Text="Output folder" FontWeight="SemiBold" Margin="0,12,0,6"/>
              <DockPanel><Button DockPanel.Dock="Right" Click="BrowseOutput_Click" Content="Browse…"/><TextBox x:Name="OutputBox" VerticalContentAlignment="Center" MinHeight="38" Margin="0,0,10,8"/></DockPanel>
              <StackPanel x:Name="FormatPanel" Visibility="Collapsed"><TextBlock Text="Output format" FontWeight="SemiBold" Margin="0,10,0,6"/><ComboBox x:Name="FormatBox" SelectedIndex="0" Height="36" SelectionChanged="FormatBox_SelectionChanged"><ComboBoxItem Content="JPG"/><ComboBoxItem Content="PNG"/><ComboBoxItem Content="GIF"/><ComboBoxItem Content="WEBP"/><ComboBoxItem Content="AVIF"/></ComboBox></StackPanel>
              <StackPanel x:Name="QualityPanel" Visibility="Collapsed"><TextBlock Text="Quality" FontWeight="SemiBold" Margin="0,16,0,4"/><Slider x:Name="QualitySlider" Minimum="10" Maximum="100" Value="82" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="QualitySlider_ValueChanged"/><TextBlock x:Name="QualityLabel" Text="82" HorizontalAlignment="Right"/></StackPanel>
              <StackPanel x:Name="ResizeModePanel" Visibility="Collapsed"><TextBlock Text="Resize by" FontWeight="SemiBold" Margin="0,16,0,6"/><ComboBox x:Name="ResizeModeBox" SelectedIndex="0" Height="36" SelectionChanged="ResizeModeBox_SelectionChanged"><ComboBoxItem Content="Fit pixels"/><ComboBoxItem Content="Exact pixels"/><ComboBoxItem Content="Percent"/></ComboBox><TextBlock Text="Fit pixels keeps the aspect ratio and does not enlarge. Exact pixels sets both dimensions." Foreground="#627085" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
              <StackPanel x:Name="PercentPanel" Visibility="Collapsed"><TextBlock Text="Scale to percentage of original" FontWeight="SemiBold" Margin="0,16,0,6"/><DockPanel><TextBox x:Name="PercentBox" Text="50" Width="90" Padding="8" HorizontalAlignment="Left"/><TextBlock Text=" %" VerticalAlignment="Center"/></DockPanel></StackPanel>
              <StackPanel x:Name="SizePanel" Visibility="Collapsed"><CheckBox x:Name="ResizeWithCompressionBox" Content="Also resize images" Checked="ResizeWithCompressionBox_Changed" Unchecked="ResizeWithCompressionBox_Changed" Margin="0,12,0,6"/><TextBlock x:Name="SizeTitle" Text="Maximum dimensions (0 keeps original)" FontWeight="SemiBold" Margin="0,4,0,6"/><StackPanel x:Name="SizeFields" Orientation="Horizontal"><TextBox x:Name="WidthBox" Text="1920" Width="90" Padding="8"/><TextBlock x:Name="SizeSeparator" Text="  ×  " VerticalAlignment="Center"/><TextBox x:Name="HeightBox" Text="0" Width="90" Padding="8"/><TextBlock Text=" px" VerticalAlignment="Center"/></StackPanel><TextBlock x:Name="SizeHint" Text="Aspect ratio is preserved. Images are never enlarged." Foreground="#627085" Margin="0,6,0,0"/></StackPanel>
              <StackPanel x:Name="ImageCropPanel" Visibility="Collapsed"><TextBlock Text="Crop rectangle" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBlock Text="Drag on the preview, or enter X, Y, width and height in pixels. The same rectangle applies to every selected image." Foreground="#627085" TextWrapping="Wrap" Margin="0,0,0,8"/><TextBlock x:Name="CropPreviewLabel" Foreground="#627085" Margin="0,0,0,6"/><Grid Width="420" Height="280" HorizontalAlignment="Left" Background="#F0F3F9"><Image x:Name="CropPreviewImage" Stretch="Uniform"/><Canvas x:Name="CropPreviewCanvas" Background="Transparent" MouseLeftButtonDown="CropPreview_MouseDown" MouseMove="CropPreview_MouseMove" MouseLeftButtonUp="CropPreview_MouseUp"><Rectangle x:Name="CropSelection" Visibility="Collapsed" Stroke="#2766CF" StrokeThickness="2" Fill="#442766CF"/></Canvas></Grid><WrapPanel Margin="0,10,0,0"><TextBlock Text="X" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="ImageCropXBox" Text="0" Width="65" Padding="5" Margin="0,0,12,0"/><TextBlock Text="Y" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="ImageCropYBox" Text="0" Width="65" Padding="5" Margin="0,0,12,0"/><TextBlock Text="Width" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="ImageCropWidthBox" Text="0" Width="65" Padding="5" Margin="0,0,12,0"/><TextBlock Text="Height" VerticalAlignment="Center" Margin="0,0,5,0"/><TextBox x:Name="ImageCropHeightBox" Text="0" Width="65" Padding="5"/></WrapPanel></StackPanel>
              <StackPanel x:Name="ImageRotatePanel" Visibility="Collapsed"><TextBlock Text="Rotation" FontWeight="SemiBold" Margin="0,16,0,6"/><ComboBox x:Name="RotateDegreesBox" SelectedIndex="0" Height="36"><ComboBoxItem Content="90° clockwise" Tag="90"/><ComboBoxItem Content="180°" Tag="180"/><ComboBoxItem Content="90° counterclockwise" Tag="270"/></ComboBox><TextBlock Text="Apply to" FontWeight="SemiBold" Margin="0,12,0,6"/><ComboBox x:Name="RotationFilterBox" SelectedIndex="0" Height="36"><ComboBoxItem Content="All images"/><ComboBoxItem Content="Landscape only"/><ComboBoxItem Content="Portrait only"/></ComboBox></StackPanel>
              <StackPanel x:Name="UpscalePanel" Visibility="Collapsed"><TextBlock Text="Enlarge by" FontWeight="SemiBold" Margin="0,16,0,6"/><ComboBox x:Name="UpscaleFactorBox" SelectedIndex="0" Height="36"><ComboBoxItem Content="2×" Tag="2"/><ComboBoxItem Content="3×" Tag="3"/><ComboBoxItem Content="4×" Tag="4"/></ComboBox><TextBlock Text="Uses high-quality interpolation. It increases pixel dimensions but cannot recover missing detail." Foreground="#627085" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
              <StackPanel x:Name="GifPanel" Visibility="Collapsed"><TextBlock Text="Time per frame (milliseconds)" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBox x:Name="GifDelayBox" Text="500" Width="110" Padding="8" HorizontalAlignment="Left"/><TextBlock Text="Frames follow the order in Selected files. Drag files there to change it." Foreground="#627085" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
              <StackPanel x:Name="PdfOptionsPanel" Visibility="Collapsed"><TextBlock Text="Page size" FontWeight="SemiBold" Margin="0,16,0,6"/><ComboBox x:Name="PageSizeBox" SelectedIndex="0" Height="36"><ComboBoxItem Content="A4"/><ComboBoxItem Content="Letter"/><ComboBoxItem Content="Legal"/><ComboBoxItem Content="Original"/></ComboBox><TextBlock Text="Margin" FontWeight="SemiBold" Margin="0,16,0,6"/><ComboBox x:Name="MarginBox" SelectedIndex="1" Height="36"><ComboBoxItem Content="None"/><ComboBoxItem Content="Small"/><ComboBoxItem Content="Medium"/><ComboBoxItem Content="Large"/></ComboBox></StackPanel>
              <StackPanel x:Name="RangePanel" Visibility="Collapsed"><TextBlock Text="Pages to extract" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBox x:Name="RangeBox" Text="1-" Padding="8"/><TextBlock Text="Examples: 1-5, 8, 12-15. Use 1- for every page." Foreground="#627085" Margin="0,6,0,0"/><CheckBox x:Name="IndividualPagesBox" Content="Create one PDF per page" Margin="0,10,0,0"/></StackPanel>
              <StackPanel x:Name="WatermarkPanel" Visibility="Collapsed"><TextBlock Text="Watermark text" FontWeight="SemiBold" Margin="0,16,0,6"/><TextBox x:Name="WatermarkBox" Padding="8" MaxLength="100"/></StackPanel>
              <StackPanel x:Name="CropPanel" Visibility="Collapsed"><TextBlock Text="Trim margins from every page (points; 72 pt = 1 inch)" FontWeight="SemiBold" Margin="0,16,0,6"/><WrapPanel><TextBlock Text="Left" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="CropLeftBox" Text="0" Width="48" Padding="4" Margin="0,0,12,0"/><TextBlock Text="Top" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="CropTopBox" Text="0" Width="48" Padding="4" Margin="0,0,12,0"/><TextBlock Text="Right" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="CropRightBox" Text="0" Width="48" Padding="4" Margin="0,0,12,0"/><TextBlock Text="Bottom" VerticalAlignment="Center" Margin="0,0,6,0"/><TextBox x:Name="CropBottomBox" Text="0" Width="48" Padding="4"/></WrapPanel></StackPanel>
              <StackPanel x:Name="PasswordPanel" Visibility="Collapsed"><TextBlock x:Name="PasswordLabel" Text="Password" FontWeight="SemiBold" Margin="0,16,0,6"/><PasswordBox x:Name="PasswordBox" Padding="8"/><StackPanel x:Name="ConfirmPasswordPanel"><TextBlock Text="Confirm password" FontWeight="SemiBold" Margin="0,12,0,6"/><PasswordBox x:Name="ConfirmPasswordBox" Padding="8"/></StackPanel></StackPanel>
              <StackPanel x:Name="BackgroundPanel" Visibility="Collapsed"><TextBlock Text="Transparent pixels in JPG" FontWeight="SemiBold" Margin="0,16,0,6"/><ComboBox x:Name="BackgroundBox" SelectedIndex="0" Height="36"><ComboBoxItem Content="White"/><ComboBoxItem Content="Black"/></ComboBox></StackPanel>
              <TextBlock x:Name="OperationNote" Margin="0,18,0,12" Foreground="#627085" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button x:Name="RunButton" Click="Run_Click" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"/><Button Click="Back_Click" Content="Back"/></StackPanel>
            </StackPanel>
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed"><ProgressBar x:Name="ProgressBar" Height="12" Minimum="0" Maximum="100"/><TextBlock x:Name="ProgressText" Margin="0,12,0,16"/><Button Click="Cancel_Click" Content="Cancel" HorizontalAlignment="Left"/></StackPanel>
            <StackPanel x:Name="ResultPanel" Visibility="Collapsed"><TextBlock x:Name="ResultSummary" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Double-click a successful result to open it." Foreground="#627085" Margin="0,8,0,0"/><ListBox x:Name="ResultsList" Height="230" Margin="0,12,0,12" MouseDoubleClick="ResultsList_MouseDoubleClick"/><StackPanel Orientation="Horizontal"><Button Click="OpenOutput_Click" Content="Open output folder"/><Button Click="Back_Click" Content="New operation"/></StackPanel></StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>
    <TextBlock Grid.Row="2" Text="Offline processing · Originals stay untouched · Outputs never overwrite existing files" Foreground="#627085" Margin="0,16,0,0"/>
  </Grid>
</Window>
